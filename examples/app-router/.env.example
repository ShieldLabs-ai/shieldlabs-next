# Copy to .env.local and fill in the keys of a registered domain (Integration > API keys in the
# analytics dashboard at https://app.shieldlabs.ai).

# Public Key of the domain. Public by design: Next.js inlines NEXT_PUBLIC_ variables into the browser
# code at build time, so set it before `next build`.
NEXT_PUBLIC_SHIELDLABS_PUBLIC_KEY=0123456789abcdef0123456789abcdef

# Private API Key of the domain, for the History API. Server only: never give it a NEXT_PUBLIC_ prefix.
SHIELDLABS_API_KEY=sec_your_private_key

# Signing secret of the webhook endpoint (Integration > Webhooks). Several secrets, separated by
# commas, while you rotate.
SHIELDLABS_WEBHOOK_SECRET=whsec_your_signing_secret

# Optional: another History API origin, for tests.
# SHIELDLABS_API_BASE_URL=
