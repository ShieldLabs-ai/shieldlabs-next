# Development settings only: npm never includes .npmrc in the published package.
# @shieldlabs-ai/js, @shieldlabs-ai/react and @shieldlabs-ai/node (peer dependencies) are not on npm yet, so npm
# cannot install them by itself: legacy-peer-deps leaves peer dependencies to you in npm ci and
# npm install. Remove this file once the three packages are published (see CONTRIBUTING.md).
legacy-peer-deps=true
